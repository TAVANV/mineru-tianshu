# 仅包含非敏感变量的合并模板：备份后逐项合并到现有 .env，禁止 cp 覆盖原文件及其密钥。
# 不创建活动 .env.registry；原密钥、自定义地址和实际 MCP 白名单保持不变。
# Linux 服务器默认 docker compose 自动读取 .env，并按下列顺序加载四份编排。
COMPOSE_FILE=docker-compose.yml:docker-compose.external-models.yml:docker-compose.vllm.yml:docker-compose.registry.yml
COMPOSE_PROFILES=
# 仅在服务器本地 .env 填写真实地址，不要将内网地址提交到仓库。
SERVER_HOST=your-server.example.com
# 前后端镜像标签是 Actions 的整数版本，与 MinerU SDK 4.2.3 无关。
TIANSHU_BACKEND_IMAGE=registry.cn-chengdu.aliyuncs.com/tavan-ai/tianshu-backend:5
TIANSHU_FRONTEND_IMAGE=registry.cn-chengdu.aliyuncs.com/tavan-ai/tianshu-frontend:4
VLLM_IMAGE=vllm/vllm-openai:v0.31.0-cu129
RUSTFS_IMAGE=rustfs/rustfs@sha256:0725587f6fcca83c1898f321424327d6e6da5e01ea20382905dd258ed5af3be4

OFFLINE_MODELS_PATH=/root/tianshu/models-offline-4.2.3
# 留空时由 config.yaml 的 tianshu.vllm_model_dir 选择；默认使用 Pro。
MINERU_VLM_MODEL_DIR=

TIANSHU_NETWORK_NAME=tianshu-network
# 通用示例；已有部署必须沿用原网络地址，勿覆盖为示例网段。
TIANSHU_SUBNET=172.28.0.0/16
TIANSHU_GATEWAY=172.28.0.1
API_PORT=8100
FRONTEND_PORT=8080
# 若原 .env 已有实际 CORS 白名单，沿用原值，勿用示例默认值覆盖。
ALLOWED_ORIGINS=http://${SERVER_HOST}:8080,http://localhost:8080,http://127.0.0.1:8080
WORKER_PORT=8001
MCP_PORT=8002
# 已有部署若配置了实际域名白名单，合并时沿用原值，勿用示例默认值覆盖。
MCP_ALLOWED_HOSTS=${SERVER_HOST}:8002,localhost:*,127.0.0.1:*,[::1]:*
MCP_ALLOWED_ORIGINS=http://${SERVER_HOST}:8080,http://${SERVER_HOST}:8002,http://localhost:*,https://localhost:*,http://127.0.0.1:*,https://127.0.0.1:*,http://[::1]:*,https://[::1]:*
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
VLLM_PORT=30024
RUSTFS_PUBLIC_URL=http://${SERVER_HOST}:9000
NGINX_CLIENT_MAX_BODY_SIZE=0
RUSTFS_SECURE=false

GPU_COUNT=1
MAX_CONCURRENT_TASKS=4
MINERU_VIRTUAL_VRAM_SIZE=6
MINERU_PROCESSING_WINDOW_SIZE=8
VLLM_GPU_MEMORY_UTILIZATION=0.2
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_BATCHED_TOKENS=8192
VLLM_MAX_NUM_SEQS=32
WORKER_MEMORY_LIMIT=32G
# Docker 的内存与 swap 总量，实际 swap 可用量取决于宿主机配置。
WORKER_MEMORY_SWAP_LIMIT=40G
WORKER_MEMORY_RESERVATION=8G

PDF_SPLIT_ENABLED=true
PDF_SPLIT_THRESHOLD_PAGES=40
PDF_SPLIT_CHUNK_SIZE=20
LITSERVE_URL=http://worker:8001/predict
SCHEDULER_MONITOR_INTERVAL=60
SCHEDULER_STALE_TASK_TIMEOUT=60
# 现有实现会同时清理过期 completed/failed 任务记录和相关文件；0 表示关闭。
SCHEDULER_CLEANUP_OLD_FILES_DAYS=7
FAIR_SCHEDULING_ENABLED=true
REDIS_QUEUE_ENABLED=false
REDIS_DB=0
